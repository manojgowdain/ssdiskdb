{
  "name": "@manojgowdain/ssdiskdb",
  "version": "0.2.0",
  "bin": {
    "ssdiskdb": "dist/cjs/cli.js"
  },
  "description": "Promise-based SSDB client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manojgowdain/ssdiskdb.git"
  },
  "bugs": {
    "url": "https://github.com/manojgowdain/ssdiskdb/issues"
  },
  "homepage": "https://manojgowda.in/",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "proto"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node scripts/write-package-markers.cjs",
    "test": "node scripts/run-node-tests.cjs",
    "typecheck": "tsc --noEmit",
    "test:package": "node scripts/test-npm-pack.cjs",
    "benchmark": "npm run build && node benchmark/local.cjs && node benchmark/grpc.cjs && node benchmark/encryption.cjs"
  },
  "keywords": [
    "ssdb",
    "ssdb-client",
    "ssdb-driver",
    "database",
    "key-value",
    "storage",
    "nosql",
    "redis-alternative",
    "promise-based",
    "typescript",
    "encryption",
    "json-serialization",
    "production-ready"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "level": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "author": "",
  "type": "commonjs"
}
